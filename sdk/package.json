{
  "name": "@trustmint/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for TrustMint smart contracts on Stellar Soroban",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc --project tsconfig.test.json && node --test .test-dist/clients/KycRegistryClient.test.js"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^12.3.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.4.5"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "stellar",
    "soroban",
    "rwa",
    "trustmint",
    "kyc",
    "compliance"
  ],
  "license": "MIT"
}
